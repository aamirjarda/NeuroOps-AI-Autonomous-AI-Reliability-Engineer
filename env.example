# NeuroOps AI — Example Environment Configuration
# Copy this file to .env only if you add a dotenv loader to the application.
# The current CLI reads OPENAI_API_KEY from your shell environment directly.
# Never put a real API key or secret in this file or commit it to GitHub.

# Optional: required only for LLM-assisted analysis
OPENAI_API_KEY=

# Documentation for future configuration support.
# These variables are not currently read by neuroops_ai.py.
NEUROOPS_LLM_MODEL=gpt-4.1-mini
NEUROOPS_LOG_LEVEL=INFO
